{
  "manifest_version": 3,
  "name": "Fo2sh Pinterest Downloader",
  "version": "1.4.1",
  "description": "Hover any Pinterest video or image and download it in the highest quality, extract audio, or grab a whole carousel.",
  "permissions": [
    "downloads",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.pinimg.com/*",
    "*://*.pinterest.ca/*",
    "*://*.pinterest.co.uk/*",
    "*://*.pinterest.com.au/*",
    "*://*.pinterest.com.mx/*",
    "*://*.pinterest.com/*",
    "*://*.pinterest.de/*",
    "*://*.pinterest.es/*",
    "*://*.pinterest.fr/*",
    "*://*.pinterest.it/*",
    "*://*.pinterest.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.com.au/*",
        "*://*.pinterest.com.mx/*",
        "*://*.pinterest.jp/*"
      ],
      "js": [
        "observer.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.com.au/*",
        "*://*.pinterest.com.mx/*",
        "*://*.pinterest.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fo2sh Pinterest Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}